VITE_RELATIVITY_API="http://0.0.0.0:8080"

# Local-first by default — no sign-in, single "Default User", all data in a
# local SQLite file. Set VITE_AUTH_MODE="supabase" to opt back into cloud
# login; the VITE_SUPABASE_* vars below are then required.
# VITE_AUTH_MODE=""

# Supabase Auth (cloud mode only) — project URL + anon (public) key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Google Identity Services Client ID (Web application) — powers the Google sign-in popup (cloud mode only).
VITE_GOOGLE_CLIENT_ID=""

# Where the NavBar "VOYAGER" pill opens the API docs (/docs).
VITE_VOYAGER_DOCS_URL="https://voyager-api-0csb.onrender.com"
