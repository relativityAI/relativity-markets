{
  "name": "relativity-markets",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch api/index.ts",
    "build": "tsc && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/api/index.js",
    "test": "vitest run --passWithNoTests",
    "cli": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx harness/cli.ts",
    "export-legacy-store": "tsx scripts/export-legacy-store.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "searxng": "docker compose -f ../docker-compose.yml up -d searxng",
    "db:reset": "rm -f data/relativity.db data/relativity.db-wal data/relativity.db-shm"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@langchain/anthropic": "^1.6.5",
    "@langchain/core": "^1.4.1",
    "@langchain/google": "^0.2.15",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/langgraph-sdk": "^1.16.0",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.8.4",
    "@langfuse/langchain": "^6.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "cockatiel": "^4.0.0",
    "cors": "^2.8.5",
    "deepagents": "^1.16.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "jose": "^6.2.8",
    "jsonrepair": "^3.15.0",
    "langchain": "^1.6.6",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.2.12",
    "picocolors": "^1.1.1",
    "string-width": "^4.2.3",
    "yahoo-finance2": "^4.0.6",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.31",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
