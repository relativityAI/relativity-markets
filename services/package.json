{
  "name": "relativity-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc && cp -r config assets dist/ && cp -r harness/config dist/harness/ && if [ -d harness/agents/defaults ]; then cp -r harness/agents/defaults dist/harness/agents/; fi",
    "typecheck": "tsc --noEmit",
    "start": "node dist/api/index.js",
    "test": "vitest run --passWithNoTests",
    "ui:demo": "tsx harness/ui/demo.ts",
    "searxng": "docker compose -f ../docker-compose.yml up -d searxng",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@dicebear/core": "^9.4.3",
    "@dicebear/notionists": "^9.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/vercel-ai-sdk": "^6.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.170",
    "cockatiel": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "jsonrepair": "^3.15.0",
    "mammoth": "^1.13.0",
    "memfs": "^4.80.0",
    "multer": "^2.2.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.3.14",
    "pg": "^8.23.1",
    "picocolors": "^1.1.1",
    "string-width": "^4.2.3",
    "yahoo-finance2": "^4.0.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/json-logic-js": "^2.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "mongodb": "^6.21.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
