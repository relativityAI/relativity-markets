{
  "_help": "Harness defaults, read by BOTH the CLI and the API server. Precedence: flags > HARNESS_* env (services/.env) > this file > built-ins. `tools` declares the agent's toolbox as MCP sources only; urls stay in env, the file holds the env var NAME (urlEnv). `keyFrom` binds a per-run credential (e.g. the user's Tavily key) into the Authorization header — the source is skipped when the run has no such key.",
  "engine": "v2",
  "model": "opencode/deepseek-v4.1-flash",
  "skills": ["chartist-technical-analysis"],
  "source": "SEC",
  "tools": {
    "mcp": [
      { "name": "yfinance", "urlEnv": "MCP_YFINANCE_URL", "required": true },
      {
        "name": "searxng",
        "urlEnv": "MCP_SEARXNG_MCP_URL",
        "webProvider": "searxng",
        "required": true,
        "allow": ["searxng_web_search", "web_url_read", "searxng_search_suggestions", "searxng_instance_info"]
      },
      {
        "name": "tradingview",
        "urlEnv": "MCP_TRADINGVIEW_URL",
        "required": false,
        "allow": [
          "financial_news",
          "coin_analysis",
          "multi_timeframe_analysis",
          "combined_analysis",
          "multi_agent_analysis",
          "market_sentiment",
          "stock_screener",
          "stock_prices",
          "backtest_strategy",
          "compare_strategies",
          "walk_forward_backtest_strategy",
          "yahoo_price"
        ]
      },
      {
        "name": "tavily",
        "url": "https://mcp.tavily.com/mcp",
        "webProvider": "tavily",
        "keyFrom": "tavilyKey",
        "required": false,
        "allow": ["tavily_search", "tavily_extract"]
      }
    ]
  },
  "budget": {
    "maxSteps": 15,
    "maxTokens": 200000,
    "maxCostUsd": 0.5,
    "maxIterations": 6,
    "cbSessions": 3,
    "cbSessionSteps": 8
  }
}
