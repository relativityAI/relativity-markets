PORT=8501

# Supabase — auth only (JWT verification via JWKS). Agent/skill/run data is
# local-first: SQLite (services/data/relativity.db) + markdown files
# (services/data/agents/**, services/data/skills/**).
SUPABASE_PROJECT_URL=https://rjqhhxdsbghjljiuohzh.supabase.co

# Local Postgres (docker compose: `docker compose up -d postgres`) — API keys + user activity.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relativity

# AES-256-GCM encryption key for stored API keys (64 hex chars = 32 bytes).
ENCRYPTION_KEY=

# MCP server urls. The harness reads which servers to use from
# harness.config.json (`tools.mcp[]`) — each entry names the env var holding
# its url via urlEnv. Streamable HTTP, tools re-listed on every run, so new
# tools appear without restarting this API.
#
# Easiest: `docker compose up -d yfmcp searxng-mcp tvmcp` from the repo root
# (compose overrides the stdio entrypoints to serve HTTP), then publish the
# ports you need for local dev:
#   yfmcp  8003->8000 · searxng-mcp 3005->3000 · tvmcp 8006->8000
MCP_YFINANCE_URL=http://localhost:8003/mcp
MCP_SEARXNG_MCP_URL=http://localhost:3005/mcp
MCP_TRADINGVIEW_URL=http://localhost:8006/mcp
# Optional: TradingView's financial_news/market_sentiment tools need a free
# Marketaux token (https://www.marketaux.com/); everything else works keyless.
# MARKETAUX_API_TOKEN=

# Per-run budgets for skill/iterative runs ("calls" = model steps / tool round-trips).
AGENT_MAX_STEPS=40
AGENT_MAX_TOKENS=200000

# Optional server-side LLM key fallbacks.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Free-tier providers (no credit card needed for a key — free signup only).
# Add a key in Settings, or configure a server-side pool below.
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# COHERE_API_KEY=
# ZAI_API_KEY=

# OpenCode Console (Go subscription or pay-as-you-go key from
# https://opencode.ai/console). Harness default model is opencode/deepseek-v4.1-flash.
# OPENCODE_API_KEY=
# Plan base URL; defaults to the Go gateway — use https://opencode.ai/inference for PAYG.
# OPENCODE_BASE_URL=https://opencode.ai/inference/go

# Langfuse tracing for agent runs (self-hostable; no-op when unset).
# Docker: `docker compose up -d langfuse` then LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Human-in-the-loop: agents may gate tools for approval via their
# interrupt_on definition field. Paused runs resume with
# POST /analysis/:id/resume { decisions: [...] }.

# Harness CLI — defaults (model, skills, soul, template, budget) live in
# harness.config.json at the api/ root. One-off overrides for the CLI only
# (flags still win; the API ignores these):
# HARNESS_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# HARNESS_SKILLS=dcf-valuation,technical-analysis
# HARNESS_SOURCE=SEC
# HARNESS_TEMPLATE=full-research
