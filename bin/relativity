#!/bin/sh
# relativity — start Relativity (Docker) and open it in your browser.
# Every run refreshes the app image first, so you always get the latest build.
# Foreground: `docker compose up` streams logs; Ctrl+C stops the containers.
# install.sh symlinks this to ~/.local/bin/relativity; works from any dir.
set -e

URL=http://127.0.0.1:8501
IMAGE=ghcr.io/relativityai/relativity-markets:latest

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *) SELF=$(dirname "$SELF")/$link ;;
  esac
done
DIR=$(cd "$(dirname "$SELF")/.." && pwd)

compose() { docker compose -f "$DIR/docker-compose.yml" "$@"; }
up() { curl -fsS -o /dev/null --max-time 2 "$URL/health" 2>/dev/null; }

open_browser() {
  case $(uname -s) in
    Darwin) open "$URL" ;;
    MINGW* | MSYS* | CYGWIN*) cmd.exe /c start "" "$URL" >/dev/null 2>&1 & ;;
    *) xdg-open "$URL" >/dev/null 2>&1 & ;;
  esac
}

open_when_up() {
  n=0
  while [ "$n" -lt 600 ]; do
    if up; then
      open_browser
      return 0
    fi
    sleep 1
    n=$((n + 1))
  done
  echo "App did not become healthy at $URL" >&2
}

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  echo "Docker is required. Install: https://docs.docker.com/get-docker/ — then re-run: bash install.sh" >&2
  exit 1
fi
if [ ! -f "$DIR/docker-compose.yml" ]; then
  echo "Not a Relativity checkout ($DIR). Run:  bash install.sh" >&2
  exit 1
fi

# Refresh the app image BEFORE anything else, so every invocation — including
# one against an already-running app — picks up the newest published build.
# Other services come from their registries on first run; tvmcp is build-only,
# so a blanket `compose pull` would always fail on it.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "(first run downloads the Docker images — a few minutes)"
fi
echo "Checking for updates..."
if ! compose pull app; then
  echo "Could not check for updates — starting with the local image." >&2
fi

latest=$(docker image inspect "$IMAGE" -f '{{.Id}}' 2>/dev/null || true)
running=$(compose ps -q app 2>/dev/null || true)

if [ -n "$running" ] && up; then
  current=$(docker inspect -f '{{.Image}}' "$running" 2>/dev/null || true)
  if [ -n "$latest" ] && [ -n "$current" ] && [ "$current" != "$latest" ]; then
    echo "Update available — restarting the app with the latest image..."
    compose up -d --no-deps --force-recreate app
    open_when_up
  else
    echo "Relativity is already running: $URL"
    open_browser
  fi
  exit 0
fi

echo "Starting Relativity: $URL  —  Ctrl+C stops it"
# Close means close: closing the terminal (SIGHUP) or Ctrl+C must take the
# stack down — otherwise the containers outlive the terminal and the app
# stays reachable in the browser (restart: unless-stopped keeps them too).
trap 'compose down' EXIT INT TERM HUP
open_when_up &
compose up
