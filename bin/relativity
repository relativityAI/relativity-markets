#!/bin/sh
# relativity — start/stop Relativity (Docker). Works from any directory.
#   relativity            start: refresh the app image, start the stack and
#                         open http://127.0.0.1:8501 once it is healthy
#   relativity stop       stop the stack
#   relativity uninstall  stop + remove the command (your data is kept)
# install.sh symlinks this into ~/.local/bin; it resolves its own location,
# so it runs against the checkout (or ~/.local/share/relativity) it came from.
set -e

URL=http://127.0.0.1:8501
IMAGE=ghcr.io/relativityai/relativity-markets:latest

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *) SELF=$(dirname "$SELF")/$link ;;
  esac
done
DIR=$(cd "$(dirname "$SELF")/.." && pwd)
COMPOSE=$DIR/docker-compose.yml

compose() { docker compose -f "$COMPOSE" "$@"; }
healthy() { curl -fsS -o /dev/null --max-time 2 "$URL/health" 2>/dev/null; }

open_browser() {
  case $(uname -s) in
    Darwin) open "$URL" ;;
    MINGW* | MSYS* | CYGWIN*) cmd.exe /c start "" "$URL" >/dev/null 2>&1 & ;;
    *) xdg-open "$URL" >/dev/null 2>&1 & ;;
  esac
}

open_when_up() {
  n=0
  while [ "$n" -lt 300 ]; do
    if healthy; then
      open_browser
      return 0
    fi
    sleep 1
    n=$((n + 1))
  done
  echo "App did not become healthy at $URL — see: docker compose -f $COMPOSE logs" >&2
}

require() {
  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "Docker is required. Install: https://docs.docker.com/get-docker/ — then re-run the installer." >&2
    exit 1
  fi
  if [ ! -f "$COMPOSE" ]; then
    echo "Missing $COMPOSE — re-run the installer." >&2
    exit 1
  fi
}

# Remove only the exact block the installer adds; leave the rest of each rc alone.
remove_path_entries() {
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    tmp="$rc.relativity-cleanup.$$"
    if ! awk -v export_line='export PATH="$HOME/.local/bin:$PATH"' '
      { line[NR] = $0 }
      END {
        skip_comment = 0
        skip_blank = 0
        i = 1
        while (i <= NR) {
          if (line[i] == export_line) {
            if ((i - 1) >= 1 && line[i - 1] == "# relativity CLI") {
              skip_comment = i - 1
              if ((i - 2) >= 1 && line[i - 2] == "") skip_blank = i - 2
            }
            i++
            continue
          }
          if (i == skip_comment || i == skip_blank) {
            i++
            continue
          }
          print line[i]
          i++
        }
      }
    ' "$rc" >"$tmp"; then
      rm -f "$tmp"
      echo "WARNING: could not clean $rc" >&2
      continue
    fi
    if cmp -s "$tmp" "$rc"; then
      rm -f "$tmp"
    else
      if [ -s "$tmp" ]; then
        mv "$tmp" "$rc"
      else
        : >"$rc"
        rm -f "$tmp"
      fi
      echo "Removed Relativity PATH entry from $rc"
    fi
  done
}

case ${1:-up} in
  up)
    require
    # Refresh the app image BEFORE anything else, so every invocation — including
    # one against an already-running app — picks up the newest published build.
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
      echo "(first run downloads the Docker images — a few minutes)"
    fi
    echo "Checking for updates..."
    if ! compose pull app; then
      echo "Could not check for updates — starting with the local image." >&2
    fi

    latest=$(docker image inspect "$IMAGE" -f '{{.Id}}' 2>/dev/null || true)
    running=$(compose ps -q app 2>/dev/null || true)

    if [ -n "$running" ] && healthy; then
      current=$(docker inspect -f '{{.Image}}' "$running" 2>/dev/null || true)
      if [ -n "$latest" ] && [ -n "$current" ] && [ "$current" != "$latest" ]; then
        echo "Update available — restarting the app with the latest image..."
        compose up -d --no-deps --force-recreate app
        open_when_up
      else
        echo "Relativity is already running: $URL"
        open_browser
      fi
      exit 0
    fi

    echo "Starting Relativity: $URL"
    # Pre-create the data dir as this user — Docker would create it root-owned
    # and the container (uid 1000) could not write its database.
    mkdir -p "$DIR/services/data"
    compose up -d
    open_when_up
    echo "Stop it with:  relativity stop"
    ;;

  stop)
    require
    echo "Stopping Relativity..."
    compose down
    echo "Stopped."
    ;;

  uninstall)
    # Best effort: docker may already be gone.
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && [ -f "$COMPOSE" ]; then
      compose down || true
    fi
    link=$HOME/.local/bin/relativity
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$SELF" ]; then
      rm -f "$link"
      echo "Removed $link"
    elif [ -L "$link" ]; then
      echo "Left $link untouched — it points to another install."
    elif [ -e "$link" ]; then
      echo "Left $link untouched — it is not a Relativity symlink."
    fi
    remove_path_entries
    if [ -e "$DIR/.git" ]; then
      echo "Left $DIR untouched (checkout — your files and data stay)."
    else
      rm -rf "$DIR/bin" "$COMPOSE"
      if [ -d "$DIR/services/data" ]; then
        echo "Kept your data: $DIR/services/data"
      fi
      rmdir "$DIR/services" 2>/dev/null || true
      rmdir "$DIR" 2>/dev/null || true
    fi
    echo "Relativity uninstalled."
    ;;

  *)
    echo "usage: relativity [up|stop|uninstall]" >&2
    exit 1
    ;;
esac
